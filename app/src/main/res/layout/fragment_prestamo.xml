<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:text="REGISTRO DE HERRAMIENTAS"
            android:textColor="#E53935"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:background="#E53935" />

        <!-- TARJETA GLASSMORPHISM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="20dp">

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtNombre"
                android:textColorHint="#666666"
                android:textColor="#000000"
                android:background="@drawable/bg_input_dark"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Marca -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marca"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtMarca"
                android:textColorHint="#666666"
                android:textColor="#000000"
                android:background="@drawable/bg_input_dark"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Descripción -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtDescripcion"
                android:hint="Ej. Uso general"
                android:textColorHint="#666666"
                android:textColor="#000000"
                android:background="@drawable/bg_input_dark"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Condición -->
            <TextView
                android:text="Condición"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <RadioButton
                    android:id="@+id/rbtBueno"
                    android:text="Bueno"
                    android:textColor="#555555"
                    android:buttonTint="#E53935"
                    android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <RadioButton
                    android:id="@+id/rbtRegular"
                    android:text="Regular"
                    android:textColor="#555555"
                    android:buttonTint="#E53935"
                    android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <RadioButton
                    android:id="@+id/rbtMalo"
                    android:text="Malo"
                    android:textColor="#555555"
                    android:buttonTint="#E53935"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </RadioGroup>

            <!-- Tipo -->
            <TextView
                android:text="Tipo"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp" />

            <RadioGroup
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbtElectrica"
                    android:text="Eléctrica"
                    android:textColor="#555555"
                    android:buttonTint="#E53935"
                    android:checked="true"
                    android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <RadioButton
                    android:id="@+id/rbtManual"
                    android:text="Manual"
                    android:textColor="#555555"
                    android:buttonTint="#E53935"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </RadioGroup>

            <!-- Botón Guardar -->
            <Button
                android:id="@+id/btnGuardarHerramienta"
                android:text="GUARDAR HERRAMIENTA"
                android:backgroundTint="#E53935"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="10dp" />

            <!-- Botón Test -->
            <Button
                android:id="@+id/btnTestWS"
                android:text="TEST CONEXIÓN"
                android:backgroundTint="#1A1A1A"
                android:textColor="#FFFCCC"
                android:textStyle="bold"
                android:layout_width="match_parent"
                android:layout_height="52dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>