<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:text="BÚSQUEDA DE HERRAMIENTAS"
            android:textColor="#E53935"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"
            android:background="#E53935" />

        <!-- BUSCADOR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <EditText
                android:id="@+id/edtIdBuscar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ID"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/bg_input_dark"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnBuscar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="BUSCAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:backgroundTint="#E53935" />

        </LinearLayout>

        <!-- TARJETA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="#555555"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/bg_input_dark"
                android:padding="14dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marca"
                android:textColor="#555555"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/bg_input_dark"
                android:padding="14dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textColor="#555555"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/bg_input_dark"
                android:padding="14dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Condición"
                android:textColor="#555555"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/rgCondicion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbtBueno"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bueno"
                    android:textColor="#333333"
                    android:buttonTint="#E53935" />

                <RadioButton
                    android:id="@+id/rbtRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Regular"
                    android:textColor="#333333"
                    android:buttonTint="#E53935" />

                <RadioButton
                    android:id="@+id/rbtMalo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Malo"
                    android:textColor="#333333"
                    android:buttonTint="#E53935" />

            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <RadioGroup
                android:id="@+id/rgTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbtElectrica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eléctrica"
                    android:textColor="#333333"
                    android:buttonTint="#E53935" />

                <RadioButton
                    android:id="@+id/rbtManual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manual"
                    android:textColor="#333333"
                    android:buttonTint="#E53935" />

            </RadioGroup>

        </LinearLayout>

    </LinearLayout>

</ScrollView>