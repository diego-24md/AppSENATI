<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTUALIZAR HERRAMIENTA"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#E53935"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- BUSCAR POR ID -->
        <EditText
            android:id="@+id/edtId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese ID"
            android:inputType="number"
            android:textColor="#000000"
            android:textColorHint="#888888"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BUSCAR"
            android:textColor="#FFFFFF"
            android:backgroundTint="#E53935"
            android:layout_marginBottom="20dp"/>

        <!-- DATOS -->
        <EditText
            android:id="@+id/edtNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre"
            android:textColor="#000000"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtMarca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Marca"
            android:textColor="#000000"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción"
            android:textColor="#000000"
            android:layout_marginBottom="15dp"/>

        <!-- CONDICIÓN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Condición"/>

        <RadioGroup
            android:id="@+id/rgCondicion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbtBueno"
                android:text="Bueno"/>

            <RadioButton
                android:id="@+id/rbtRegular"
                android:text="Regular"/>

            <RadioButton
                android:id="@+id/rbtMalo"
                android:text="Malo"/>

        </RadioGroup>

        <!-- TIPO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tipo"
            android:layout_marginTop="10dp"/>

        <RadioGroup
            android:id="@+id/rgTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbtElectrica"
                android:text="Eléctrica"    />

            <RadioButton
                android:id="@+id/rbtManual"
                android:text="Manual"   />

        </RadioGroup>

        <!-- ACTUALIZAR -->
        <Button
            android:id="@+id/btnActualizar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTUALIZAR"
            android:textColor="#FFFFFF"
            android:backgroundTint="#424242"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>